# Xiao Wi-Fi HaLow Carrier (MM8108, 3-0067)
# XIAO ESP32-S3 has 8 MB flash; widen OTA partitions (see partitions.csv) so
# the wifi_provisioning + protocomm stack fits.
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SNAPCLIENT_USE_HALOW=y
CONFIG_HALOW_COUNTRY_CODE="AU"
CONFIG_MMHAL_CHIP_TYPE_MM8108=y
CONFIG_MM_FW_FILE="mm8108b2-rl.mbin"
CONFIG_MM_BCF_FILE="bcf_mf15457.mbin"

# GPIO pinout on XIAO ESP32-S3
CONFIG_MM_RESET_N=8
CONFIG_MM_WAKE=9
CONFIG_MM_BUSY=1
CONFIG_MM_SPI_SCK=2
CONFIG_MM_SPI_MOSI=3
CONFIG_MM_SPI_MISO=43
CONFIG_MM_SPI_CS=6
CONFIG_MM_SPI_IRQ=5

# Disable PM/tickless idle — HaLow SPI needs stable clocking on weak supplies
# CONFIG_PM_ENABLE is not set
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set

# Move Wi-Fi/LWIP buffers to PSRAM to reduce internal SRAM current draw
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ENABLE_HALOW_PROVISIONING=y
CONFIG_HALOW_PROV_POP="longwave"